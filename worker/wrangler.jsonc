{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lit-talk-oauth-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-23",
  "observability": {
    "enabled": true
  },
  // Vars (GITHUB_CLIENT_ID, ALLOWED_ORIGINS) are managed in the Cloudflare
  // dashboard (Worker → Settings → Variables) so they can change without a
  // redeploy. keep_vars stops `wrangler deploy` from wiping dashboard values.
  // Local `wrangler dev` reads them from .dev.vars (gitignored).
  // GITHUB_CLIENT_SECRET (secret): `wrangler secret put GITHUB_CLIENT_SECRET`.
  "keep_vars": true
}
